# Package runners and their local test runs
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.facet-tmp-*/
*.facet.json
*.preview.html

# …but the viewer examples ship their record and preview files,
# and the hand-run checker's screenshots stay local
!viewers/_examples/**/*.facet.json
viewers/_examples/*/screens/

# instruction files stay committable
!.claude/CLAUDE.md
!.continue/rules/
!.cursor/rules/
