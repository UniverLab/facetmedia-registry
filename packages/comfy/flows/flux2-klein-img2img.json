{
  "about": "FLUX.2 klein 4B instruction-based image edit. ReferenceLatent guides edits from an input image; unlike classic img2img, this workflow has no denoise-strength control.",
  "params": { "image": "", "prompt": "", "name": "edit", "width": 1344, "height": 768, "seed": 0, "steps": 4, "cfg": 1, "sampler": "euler" },
  "uploads": ["image"],
  "graph": {
    "unet": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux-2-klein-4b.safetensors", "weight_dtype": "default" } },
    "clip": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen_3_4b_fp8_mixed.safetensors", "type": "flux2", "device": "default" } },
    "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
    "positive_text": { "class_type": "CLIPTextEncode", "inputs": { "text": "$prompt", "clip": ["clip", 0] } },
    "source": { "class_type": "LoadImage", "inputs": { "image": "$image" } },
    "encoded_source": { "class_type": "VAEEncode", "inputs": { "pixels": ["source", 0], "vae": ["vae", 0] } },
    "reference": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["positive_text", 0], "latent": ["encoded_source", 0] } },
    "negative": { "class_type": "ConditioningZeroOut", "inputs": { "conditioning": ["positive_text", 0] } },
    "guider": { "class_type": "CFGGuider", "inputs": { "model": ["unet", 0], "positive": ["reference", 0], "negative": ["negative", 0], "cfg": "$cfg" } },
    "latent": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": "$width", "height": "$height", "batch_size": 1 } },
    "sigmas": { "class_type": "Flux2Scheduler", "inputs": { "steps": "$steps", "width": "$width", "height": "$height" } },
    "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": "$seed" } },
    "select": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "$sampler" } },
    "sampler": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["select", 0], "sigmas": ["sigmas", 0], "latent_image": ["latent", 0] } },
    "decode": { "class_type": "VAEDecode", "inputs": { "samples": ["sampler", 0], "vae": ["vae", 0] } },
    "save": { "class_type": "SaveImage", "inputs": { "images": ["decode", 0], "filename_prefix": "$name" } }
  }
}
