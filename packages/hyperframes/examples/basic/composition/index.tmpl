<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="./vendor/gsap.min.js"></script>
    <style>
      @font-face { font-family: 'Old Standard TT'; src: url('./assets/fonts/OldStandard-Regular.ttf'); font-weight: 400; }
      @font-face { font-family: 'Sometype Mono'; src: url('./assets/fonts/SometypeMono[wght].ttf'); }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #222928; }
      #root { position: relative; width: 100%; height: 100%; font-family: 'Old Standard TT', serif; color: #ecebe4; }
      #title { position: absolute; left: 120px; top: 120px; font-size: 72px; font-weight: 400; letter-spacing: -0.02em; }
      #counter { position: absolute; left: 120px; top: 260px; font-size: 160px; font-family: 'Sometype Mono', monospace; color: #e6c84a; font-variant-numeric: tabular-nums; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="3" data-width="1920" data-height="1080" data-fps="24">
      <h1 id="title" class="clip" data-start="0" data-duration="3" data-track-index="0">HyperFrames</h1>
      <p id="counter" class="clip" data-start="0" data-duration="3" data-track-index="1">0</p>
    </div>
    <script>
      // One paused timeline on window.__timelines, keyed by data-composition-id.
      // The counter tweens textContent with snap: the render seeks each frame.
      const tl = gsap.timeline({ paused: true });
      tl.from('#title', { opacity: 0, y: 24, duration: 0.6 }, 0);
      tl.to('#counter', { textContent: 42, snap: { textContent: 1 }, duration: 2 }, 0.4);
      window.__timelines['main'] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
