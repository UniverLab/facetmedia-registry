<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1920, height=1080" />
    <script src="./vendor/gsap.min.js"></script>
    <style>
      @font-face { font-family: 'Ubuntu'; src: local('Ubuntu'); }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1920px; height: 1080px; overflow: hidden; background: #f3efe6; }
      #root { position: relative; width: 100%; height: 100%; font-family: 'Ubuntu', sans-serif; color: #2b2622; }
      #titulo { position: absolute; left: 120px; top: 120px; font-size: 72px; font-weight: 500; }
      .sub { position: absolute; left: 160px; right: 160px; bottom: 80px; opacity: 0; text-align: center; font-size: 44px; line-height: 1.25; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="4" data-width="1920" data-height="1080" data-fps="24">
      <h1 id="titulo" class="clip" data-start="0" data-duration="4" data-track-index="0">Narrado</h1>
      <!-- SUBS -->
      <!-- AUDIOS -->
    </div>
    <script>
      const tl = gsap.timeline({ paused: true });
      tl.from('#titulo', { opacity: 0, y: 20, duration: 0.5 }, 0);
      window.__timelines['main'] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
